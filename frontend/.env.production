# Used by `npm run build`. Overrides local `.env` so localhost is not baked into the bundle.
# Empty = same origin (Nginx serves the UI and proxies /api).
# On Render, set VITE_API_BASE_URL in the static-site env (public API origin, no trailing slash).
# A non-empty process env value wins over this empty default.
VITE_API_BASE_URL=
