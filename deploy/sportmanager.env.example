# Copy to /etc/sportmanager/sportmanager.env on the VPS.
# That path is outside Git. Never commit a filled-in copy.

SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Jerusalem

DB_URL=jdbc:postgresql://127.0.0.1:5432/sportmanager
DB_USERNAME=sportmanager
DB_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_use_a_long_random_string_at_least_32_chars
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Exact browser origin, no trailing slash. Must match the public HTTPS site.
CORS_ALLOWED_ORIGINS=https://YOUR-DOMAIN

# First boot: update. After the schema is stable: validate.
JPA_DDL_AUTO=update

LOG_FILE=/var/log/sportmanager/application.log
SERVER_PORT=8080
